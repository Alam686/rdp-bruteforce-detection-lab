SecurityEvent
| where TimeGenerated between (
    datetime(2026-10-21 06:30:00) ..
    datetime(2026-10-21 06:45:00)
)
| where Computer has "VM-Windows"
| where EventID in (4624, 4625)
| where LogonType in (3, 10)
| where IpAddress == "106.192.188.133"
| project
    TimeGenerated,
    Computer,
    EventID,
    TargetUserName,
    IpAddress,
    LogonType,
    Activity
| order by TimeGenerated asc